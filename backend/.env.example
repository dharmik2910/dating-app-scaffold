DATABASE_URL="postgresql://user:password@localhost:5432/dating_app?schema=public"
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Firebase Admin (phone auth verification)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client-email@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# AWS S3 Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="dating-app-photos"
AWS_S3_PUBLIC_URL="https://your-bucket.s3.us-east-1.amazonaws.com"

# Cloudflare R2 (S3-compatible alternative)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="dating-app-photos"
R2_PUBLIC_URL="https://your-r2-public-url.com"
